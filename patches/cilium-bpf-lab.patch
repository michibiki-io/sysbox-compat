+package seccomp
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+)
+
+func TestCiliumJITProbeReply(t *testing.T) {
+	order := binary.NativeEndian
+	for _, test := range []struct {
+		name       string
+		kind       uint32
+		tag        [32]byte
+		translated bool
+		length     int
+		want       bool
+	}{
+		{"socket filter", socketFilterType, ciliumJITProbeTag, false, 16, true},
+		{"XDP", xdpProgramType, ciliumDeadCodeProbeTag, true, 20, true},
+		{"other tag", xdpProgramType, [32]byte{}, true, 20, false},
+		{"other program type", 3, ciliumJITProbeTag, false, 16, false},
+		{"socket filter raw request", socketFilterType, ciliumJITProbeTag, true, 16, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var info [24]byte
+			order.PutUint32(info[:4], test.kind)
+			order.PutUint32(info[4:8], 42)
+			copy(info[8:16], test.tag[:8])
+			order.PutUint32(info[16:20], 128)
+			order.PutUint32(info[20:24], 64)
+			reply := ciliumJITProbeReply(info, 256, test.translated)
+			if !test.want {
+				if reply != nil {
+					t.Fatal("unexpected experimental response")
+				}
+				return
+			}
+			want := make([]byte, 256)
+			copy(want[:16], info[:16])
+			copy(want[test.length:test.length+4], info[test.length:test.length+4])
+			if !bytes.Equal(reply, want) {
+				t.Fatal("response differs from permitted scalar fields")
+			}
+		})
+	}
+}
