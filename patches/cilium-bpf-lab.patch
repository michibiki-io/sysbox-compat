+package seccomp
+
+import (
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func TestPerfOutputLabScope(t *testing.T) {
+	id := strings.Repeat("a", 64)
+	other := strings.Repeat("b", 64)
+	policy := []byte(id+" /lab/node\n"+other+" /lab/other\n"+id+" /lab/node/deeper\n")
+	for _, test := range []struct{ container, caller, want string }{
+		{id, "/lab/node/kubepods/pod", "/lab/node"},
+		{id, "/lab/node/deeper/pod", "/lab/node/deeper"},
+		{id, "/lab/node", "/lab/node"},
+		{id, "/lab/node-sibling/pod", ""},
+		{id, "/lab/other", ""},
+		{other, "/lab/node", ""},
+		{id, "/lab", ""},
+	} {
+		if got := perfOutputScope(policy, test.container, test.caller); got != test.want {
+			t.Errorf("%s under %q: got %q, want %q", test.container, test.caller, got, test.want)
+		}
+	}
+}
+
+func TestPerfOutputLabAttrs(t *testing.T) {
+	order := binary.NativeEndian
+	attr := make([]byte, 128)
+	order.PutUint32(attr[0:4], perfOutputType)
+	order.PutUint32(attr[4:8], uint32(len(attr)))
+	order.PutUint64(attr[8:16], perfOutputConfig)
+	order.PutUint64(attr[24:32], perfSampleRaw)
+	order.PutUint64(attr[40:48], perfWatermark)
+	order.PutUint32(attr[48:52], 1)
+	if !perfOutputAttr(attr) {
+		t.Fatal("Cilium-compatible BPF output request rejected")
+	}
+	for _, offset := range []int{0, 4, 8, 16, 24, 32, 40, 51, 52, 127} {
+		rejected := append([]byte(nil), attr...)
+		rejected[offset] = 255
+		if perfOutputAttr(rejected) {
+			t.Errorf("unapproved attribute byte at offset %d accepted", offset)
+		}
+	}
+	if perfOutputAttr(attr[:56]) || perfOutputAttr(append(attr, make([]byte, 16)...)) {
+		t.Fatal("unsupported perf_event_attr sizes accepted")
+	}
+}
