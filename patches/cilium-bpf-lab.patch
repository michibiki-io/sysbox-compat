@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package syscont
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+)
+
+func TestCiliumNotificationsByDefault(t *testing.T) {
+	t.Setenv("SYSBOX_EXPERIMENT_PERF_OUTPUT", "")
+	config := &configs.Config{}
+	if err := AddSyscallTraps(config); err != nil {
+		t.Fatal(err)
+	}
+
+	want := []*configs.Syscall{
+		{Name: "mount", Action: configs.Notify},
+		{Name: "umount2", Action: configs.Notify},
+		{Name: "perf_event_open", Action: configs.Notify},
+		{Name: "bpf", Action: configs.Notify, Args: []*configs.Arg{{
+			Index: 0, Op: configs.EqualTo, Value: 15,
+		}}},
+	}
+	if notif := config.SeccompNotif; notif == nil ||
+		notif.DefaultAction != configs.Allow || !reflect.DeepEqual(notif.Syscalls, want) {
+		t.Fatalf("unexpected syscall notifications: %#v", notif)
+	}
+}
