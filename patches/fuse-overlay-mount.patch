index 0000000..21f9374
--- /dev/null
+++ b/sysbox-fs/seccomp/fuse_target.go
@@ -0,0 +1,661 @@
+package seccomp
+
+import (
+	"bufio"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/nestybox/sysbox-fs/sysfstransfer"
+	libseccomp "github.com/seccomp/libseccomp-golang"
+	"github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+)
+
+type fuseMountTarget struct {
+	file *os.File
+	path string
+}
+
+// This runs only after the ordinary lookup failed. The mount ID returned with
+// the file descriptor must identify a path on or below a fuse-overlayfs
+// mount in the notifying thread's mount table.
+func (m *mountSyscallInfo) resolveFuseMountTarget(path, raw string) (*fuseMountTarget, error) {
+	if !m.canResolveFuseTarget() {
+		return nil, nil
+	}
+	return m.syscallCtx.runFuseTargetWorker(m.notifyFd, path, raw, m.FsType, "lookup", nil)
+}
+
+// The post-pivot detach is the only unmount supported by this fallback.
+// It operates on the pinned old root FD and retains the immutable policy.
+func (u *umountSyscallInfo) detachFusePreviousRoot(notifyFD int32) (*sysResponse, bool, error) {
+	if !u.tracer.service.allowImmutableUnmounts || u.Target != "." || u.Flags != unix.MNT_DETACH {
+		return nil, false, nil
+	}
+	detached, err := u.syscallCtx.runFuseTargetWorker(notifyFD, ".", "", "", "detach", nil)
+	if err != nil {
+		return u.tracer.createErrorResponse(u.reqId, sysfstransfer.Errno(err)), true, nil
+	}
+	if detached == nil {
+		return nil, false, nil
+	}
+	return u.tracer.createSuccessResponse(u.reqId), true, nil
+}
+
+// The pinned remount worker applies the requested attribute without clearing
+// unrelated protections or resolving the target path again.
+func (m *mountSyscallInfo) setFuseMountAttribute(operation string) (*sysResponse, error) {
+	result, err := m.syscallCtx.runFuseTargetWorker(m.notifyFd, "/", "", strconv.FormatUint(m.Flags, 10), operation, m.fuseTarget.file)
+	if err != nil {
+		return m.tracer.createErrorResponse(m.reqId, sysfstransfer.Errno(err)), nil
+	}
+	if result == nil {
+		return m.tracer.createErrorResponse(m.reqId, syscall.ENOENT), nil
+	}
+	return m.tracer.createSuccessResponse(m.reqId), nil
+}
+
+func (m *syscallCtx) runFuseTargetWorker(notifyFD int32, path, raw, fsType, operation string, pinned *os.File) (*fuseMountTarget, error) {
+	helper := os.Getenv("SYSBOX_PROC_TRANSFER_HELPER")
+	if helper == "" {
+		return nil, nil
+	}
+	valid := func() error {
+		return libseccomp.NotifIDValid(libseccomp.ScmpFd(notifyFD), m.reqId)
+	}
+	if err := valid(); err != nil {
+		return nil, err
+	}
+
+	// Preflight without retaining any new descriptors or task state while
+	// queued. Credentials and mount topology are read after admission.
+	taskRoot := fmt.Sprintf("/proc/%d", m.pid)
+	hasOverlay, err := requesterHasFuseOverlay(taskRoot)
+	if err != nil || !hasOverlay {
+		return nil, err
+	}
+	key := m.cntr.ID()
+	deadline := time.Now().Add(15 * time.Second)
+	if err := fuseWorkers.acquire(key, deadline, valid); err != nil {
+		return nil, err
+	}
+	started := false
+	defer func() {
+		if !started {
+			fuseWorkers.release(key)
+		}
+	}()
+
+	pidfd, err := openProcRequesterPidfd(int(m.pid), unix.PidfdOpen)
+	if err != nil {
+		return nil, nil
+	}
+	files := []*os.File{os.NewFile(uintptr(pidfd), "requester pidfd")}
+	defer func() {
+		for _, file := range files {
+			file.Close()
+		}
+	}()
+	taskFD, err := unix.Open(taskRoot, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(taskFD)
+
+	statusText, err := readMountRequesterFile(taskFD, "status")
+	if err != nil {
+		return nil, err
+	}
+	status := make(map[string][]string)
+	for _, line := range strings.Split(statusText, "\n") {
+		if name, value, ok := strings.Cut(line, ":"); ok {
+			status[name] = strings.Fields(value)
+		}
+	}
+	args := []string{"--lookup-fuse-target", "path", fsType}
+	procFD, directFD := fuseTargetProcFD(raw, status["Tgid"], m.pid)
+	if directFD {
+		args[1] = "fd"
+	} else if strings.HasPrefix(raw, "/proc/self/fd/") || strings.HasPrefix(raw, "/proc/thread-self/fd/") {
+		// A nonleader /proc/self lookup uses the leader's descriptor table.
+		// Never substitute the notifying thread's table for that case.
+		return nil, nil
+	}
+	for _, field := range []string{"Uid", "Gid"} {
+		mappings, err := readMountRequesterFile(taskFD, strings.ToLower(field)+"_map")
+		if err != nil {
+			return nil, err
+		}
+		mapped, err := mapFuseRequesterIDs(status[field], mappings)
+		if err != nil {
+			logrus.Debugf("FUSE requester's %s map is incompatible tid=%d: %v", field, m.pid, err)
+			return nil, nil
+		}
+		args = append(args, mapped...)
+	}
+	if len(status["CapEff"]) != 1 {
+		return nil, syscall.EINVAL
+	}
+	capabilities, err := strconv.ParseUint(status["CapEff"][0], 16, 64)
+	if err != nil {
+		return nil, err
+	}
+	args = append(args, strconv.FormatUint(capabilities&0xffffffff, 10), strconv.FormatUint(capabilities>>32, 10))
+	args = append(args, status["Groups"]...)
+
+	for _, path := range []string{"root", "cwd"} {
+		fd, err := unix.Openat(taskFD, path, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return nil, err
+		}
+		files = append(files, os.NewFile(uintptr(fd), "requester "+path))
+	}
+	if operation == "detach" {
+		mountInfo, err := readMountRequesterFile(taskFD, "mountinfo")
+		if err != nil {
+			return nil, err
+		}
+		table, _, err := parseFuseMountTable(mountInfo)
+		if err != nil {
+			return nil, err
+		}
+		eligible, err := m.verifyPreviousRoot(taskFD, files[1], files[2], table)
+		if err != nil || !eligible {
+			return nil, err
+		}
+		args[1] = "detach"
+	} else if operation != "lookup" {
+		args[1] = operation
+	}
+
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(pair[0])
+	files = append(files, os.NewFile(uintptr(pair[1]), "lookup reply"))
+	if directFD {
+		duplicate, err := unix.PidfdGetfd(pidfd, procFD, 0)
+		if err != nil {
+			return nil, err
+		}
+		files = append(files, os.NewFile(uintptr(duplicate), "requester target"))
+	} else if pinned != nil {
+		duplicate, err := unix.FcntlInt(pinned.Fd(), unix.F_DUPFD_CLOEXEC, 0)
+		if err != nil {
+			return nil, err
+		}
+		files = append(files, os.NewFile(uintptr(duplicate), "pinned FUSE target"))
+	}
+
+	cmd := exec.Command(helper, args...)
+	cmd.ExtraFiles = files
+	cmd.Env = []string{}
+	guard, ok := m.tracer.service.nss.(interface{ WithChildReaperGuard(func() error) error })
+	if !ok {
+		return nil, syscall.ENOTSUP
+	}
+	err = guard.WithChildReaperGuard(func() error {
+		if err := valid(); err != nil {
+			return err
+		}
+		if !time.Now().Before(deadline) {
+			return syscall.ETIMEDOUT
+		}
+		return cmd.Start()
+	})
+	if err != nil {
+		return nil, err
+	}
+	started = true
+
+	_ = files[3].Close()
+	target, id, err := awaitFuseWorker(cmd, pair[0], path, deadline, func() {
+		fuseWorkers.release(key)
+	})
+	if err != nil {
+		logrus.Debugf("FUSE worker failed tid=%d operation=%s: %v", m.pid, operation, err)
+		return nil, err
+	}
+	if operation != "lookup" {
+		if target.file != nil {
+			target.file.Close()
+			return nil, syscall.EIO
+		}
+		return target, nil
+	}
+	if target.file == nil {
+		return nil, syscall.EIO
+	}
+	mountInfo, err := readMountRequesterFile(taskFD, "mountinfo")
+	if err != nil {
+		target.file.Close()
+		return nil, err
+	}
+	table, _, err := parseFuseMountTable(mountInfo)
+	if err != nil {
+		target.file.Close()
+		return nil, err
+	}
+	if !fuseOverlayAncestor(table, id) {
+		target.file.Close()
+		return nil, nil
+	}
+	if err := libseccomp.NotifIDValid(libseccomp.ScmpFd(notifyFD), m.reqId); err != nil {
+		target.file.Close()
+		return nil, err
+	}
+	return target, nil
+}
+
+// Do not hold the reaper guard or wait for the process to exit before
+// replying. A worker can remain in the kernel after SIGKILL.
+func awaitFuseWorker(cmd *exec.Cmd, socket int, path string, deadline time.Time, onExit func()) (*fuseMountTarget, uint64, error) {
+	go func() {
+		_ = cmd.Wait()
+		onExit()
+	}()
+	if err := unix.Sendmsg(socket, []byte(path), nil, nil, unix.MSG_DONTWAIT|unix.MSG_NOSIGNAL); err != nil {
+		_ = cmd.Process.Kill()
+		return nil, 0, syscall.EIO
+	}
+	if err := pollFuseWorker(socket, time.Until(deadline)); err != nil {
+		_ = cmd.Process.Kill()
+		return nil, 0, err
+	}
+	return readFuseMountTarget(socket)
+}
+
+// A FUSE-root request may still have the old root as its cwd after
+// pivot_root. Verify the mount topology in a separate mount namespace.
+// A cwd at a protected proc/sys mount or a shared mount is ineligible.
+func (m *syscallCtx) verifyPreviousRoot(taskFD int, root, cwd *os.File, table map[uint64]fuseMountTableEntry) (bool, error) {
+	id, err := fuseDescriptorMountID(root)
+	if err != nil {
+		return false, err
+	}
+	if !fuseOverlayAncestor(table, id) {
+		return false, nil
+	}
+
+	var requesterNS, outerNS unix.Stat_t
+	if err := unix.Fstatat(taskFD, "ns/mnt", &requesterNS, 0); err != nil {
+		return false, err
+	}
+	outer := fmt.Sprintf("/proc/%d", m.cntr.InitPid())
+	if err := unix.Stat(outer+"/ns/mnt", &outerNS); err != nil {
+		return false, err
+	}
+	if requesterNS.Dev == outerNS.Dev && requesterNS.Ino == outerNS.Ino {
+		return false, nil
+	}
+	oldID, err := fuseDescriptorMountID(cwd)
+	if err != nil {
+		return false, err
+	}
+	// pivot_root(".", ".") stacks the previous root directly on the
+	// requester's new root. Its mountpoint in the new view is "/".
+	old, known := table[oldID]
+	if known && oldID != id && old.parent == id && old.mountpoint == "/" &&
+		old.root == "/" && !old.shared && old.filesystem != "proc" &&
+		old.filesystem != "sysfs" && !(old.filesystem == "fuse" && old.source == "sysboxfs") {
+		return true, nil
+	}
+	logrus.Debugf("FUSE previous root not eligible tid=%d root=%d cwd=%d mount=%+v present=%v", m.pid, id, oldID, old, known)
+	return false, nil
+}
+
+func fuseDescriptorMountID(file *os.File) (uint64, error) {
+	info, err := os.ReadFile(fmt.Sprintf("/proc/self/fdinfo/%d", file.Fd()))
+	if err != nil {
+		return 0, err
+	}
+	for _, line := range strings.Split(string(info), "\n") {
+		if strings.HasPrefix(line, "mnt_id:") {
+			var id uint64
+			_, err := fmt.Sscanf(line, "mnt_id: %d", &id)
+			return id, err
+		}
+	}
+	return 0, syscall.EINVAL
+}
+
+type fuseMountTableEntry struct {
+	parent     uint64
+	filesystem string
+	source     string
+	root       string
+	mountpoint string
+	shared     bool
+}
+
+func parseFuseMountTable(text string) (map[uint64]fuseMountTableEntry, bool, error) {
+	table := make(map[uint64]fuseMountTableEntry)
+	hasOverlay := false
+	mounts := bufio.NewScanner(strings.NewReader(text))
+	mounts.Buffer(make([]byte, 4096), 512*1024)
+	for mounts.Scan() {
+		prefix, suffix, separated := strings.Cut(mounts.Text(), " - ")
+		fields := strings.Fields(prefix)
+		tail := strings.SplitN(suffix, " ", 3)
+		if !separated || len(fields) < 6 || len(tail) != 3 || tail[0] == "" || tail[2] == "" {
+			return nil, false, syscall.EINVAL
+		}
+		id, err := strconv.ParseUint(fields[0], 10, 64)
+		if err != nil {
+			return nil, false, err
+		}
+		parent, err := strconv.ParseUint(fields[1], 10, 64)
+		if err != nil {
+			return nil, false, err
+		}
+		filesystem := tail[0]
+		entry := fuseMountTableEntry{
+			parent: parent, filesystem: filesystem, source: tail[1],
+			root: fields[3], mountpoint: fields[4],
+		}
+		for _, field := range fields[6:] {
+			entry.shared = entry.shared || strings.HasPrefix(field, "shared:")
+		}
+		table[id] = entry
+		hasOverlay = hasOverlay || filesystem == "fuse.fuse-overlayfs"
+	}
+	return table, hasOverlay, mounts.Err()
+}
+
+func fuseOverlayAncestor(table map[uint64]fuseMountTableEntry, id uint64) bool {
+	for steps := 0; steps < len(table); steps++ {
+		mount, found := table[id]
+		if !found {
+			return false
+		}
+		if mount.filesystem == "fuse.fuse-overlayfs" {
+			return true
+		}
+		id = mount.parent
+	}
+	return false
+}
+
+// Proc uses the pinned descriptor. Simple bind and new mounts continue via
+// the existing dispatch rules. Exclude emulated mounts that reopen the target.
+func fuseBindAtimeOperation(flags uint64) string {
+	const bindRemount = unix.MS_BIND | unix.MS_REMOUNT
+	switch flags &^ unix.MS_REC {
+	case bindRemount | unix.MS_NOATIME:
+		return "noatime"
+	case bindRemount | unix.MS_RELATIME:
+		return "relatime"
+	case bindRemount | unix.MS_STRICTATIME:
+		return "strictatime"
+	default:
+		return ""
+	}
+}
+
+func (m *mountSyscallInfo) canResolveFuseTarget() bool {
+	mh := m.tracer.service.mts.MountHelper()
+	if mh.IsNewMount(m.Flags) && !mh.IsRemount(m.Flags) && !mh.IsBind(m.Flags) &&
+		!mh.IsMove(m.Flags) && !mh.HasPropagationFlag(m.Flags) {
+		switch m.FsType {
+		case "sysfs":
+			return os.Getenv("SYSBOX_SYSFS_TRANSFER_HELPER") != ""
+		case "overlay", "nfs", "cifs", "smb3":
+			return false
+		default:
+			return true
+		}
+	}
+	if mh.IsMove(m.Flags) || mh.HasPropagationFlag(m.Flags) {
+		return false
+	}
+	if mh.IsRemount(m.Flags) {
+		// The fallback can tighten the read-only flag or change only atime.
+		return mh.IsReadOnlyMount(m.Flags) || fuseBindAtimeOperation(m.Flags) != ""
+	}
+	return mh.IsBind(m.Flags)
+}
+
+func fuseTargetProcFD(raw string, tgid []string, tid uint32) (int, bool) {
+	descriptor, ok := strings.CutPrefix(raw, "/proc/thread-self/fd/")
+	if !ok && len(tgid) == 1 && tgid[0] == strconv.FormatUint(uint64(tid), 10) {
+		descriptor, ok = strings.CutPrefix(raw, "/proc/self/fd/")
+	}
+	if !ok {
+		return 0, false
+	}
+	fd, err := strconv.ParseUint(descriptor, 10, 31)
+	return int(fd), err == nil && strconv.FormatUint(fd, 10) == descriptor
+}
+
+func requesterHasFuseOverlay(taskPath string) (bool, error) {
+	taskFD, err := unix.Open(taskPath, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return false, err
+	}
+	defer unix.Close(taskFD)
+	info, err := readMountRequesterFile(taskFD, "mountinfo")
+	if err != nil {
+		return false, err
+	}
+	_, found, err := parseFuseMountTable(info)
+	return found, err
+}
+
+func readMountRequesterFile(taskFD int, name string) (string, error) {
+	fd, err := unix.Openat(taskFD, name, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return "", err
+	}
+	file := os.NewFile(uintptr(fd), name)
+	defer file.Close()
+	data, err := io.ReadAll(file)
+	return string(data), err
+}
+
+func mapFuseRequesterIDs(ids []string, mappings string) ([]string, error) {
+	if len(ids) != 4 {
+		return nil, syscall.EINVAL
+	}
+	mapped := make([]string, 0, len(ids))
+	for _, value := range ids {
+		id, err := strconv.ParseUint(value, 10, 32)
+		if err != nil {
+			return nil, err
+		}
+		var found bool
+		for _, line := range strings.Split(strings.TrimSpace(mappings), "\n") {
+			var local, parent, length uint64
+			if _, err := fmt.Sscan(line, &local, &parent, &length); err != nil {
+				return nil, err
+			}
+			if id >= parent && id-parent < length {
+				mapped = append(mapped, strconv.FormatUint(local+id-parent, 10))
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, syscall.EOVERFLOW
+		}
+	}
+	return mapped, nil
+}
+
+const (
+	fuseWorkersPerContainer = 8
+	fuseWorkersTotal        = 64
+	fuseQueuePerContainer   = 32
+	fuseQueueTotal          = 256
+)
+
+type fuseWorkerLimit struct {
+	sync.Mutex
+	active      int
+	byContainer map[string]int
+	pending     int
+	waiting     map[string]int
+	changed     chan struct{}
+}
+
+var fuseWorkers = fuseWorkerLimit{byContainer: make(map[string]int)}
+
+func (l *fuseWorkerLimit) acquire(id string, deadline time.Time, valid func() error) error {
+	var check *time.Ticker
+	var expiry *time.Timer
+	queued := false
+	defer func() {
+		if queued {
+			l.Lock()
+			l.pending--
+			l.waiting[id]--
+			if l.waiting[id] == 0 {
+				delete(l.waiting, id)
+			}
+			l.Unlock()
+		}
+		if check != nil {
+			check.Stop()
+			expiry.Stop()
+		}
+	}()
+
+	for {
+		if !time.Now().Before(deadline) {
+			return syscall.ETIMEDOUT
+		}
+		if err := valid(); err != nil {
+			return err
+		}
+		l.Lock()
+		if l.active < fuseWorkersTotal && l.byContainer[id] < fuseWorkersPerContainer {
+			l.active++
+			l.byContainer[id]++
+			l.Unlock()
+			return nil
+		}
+		if !queued {
+			if l.pending >= fuseQueueTotal || l.waiting[id] >= fuseQueuePerContainer {
+				l.Unlock()
+				return syscall.EAGAIN
+			}
+			if l.waiting == nil {
+				l.waiting = make(map[string]int)
+			}
+			l.waiting[id]++
+			l.pending++
+			queued = true
+		}
+		if l.changed == nil {
+			l.changed = make(chan struct{})
+		}
+		changed := l.changed
+		l.Unlock()
+
+		if check == nil {
+			check = time.NewTicker(100 * time.Millisecond)
+			expiry = time.NewTimer(time.Until(deadline))
+		}
+		select {
+		case <-expiry.C:
+			return syscall.ETIMEDOUT
+		case <-check.C:
+			// An interrupted notification must not keep its place in line.
+		case <-changed:
+		}
+	}
+}
+
+func (l *fuseWorkerLimit) release(id string) {
+	l.Lock()
+	defer l.Unlock()
+	l.active--
+	l.byContainer[id]--
+	if l.byContainer[id] == 0 {
+		delete(l.byContainer, id)
+	}
+	if l.changed != nil {
+		close(l.changed)
+		l.changed = nil
+	}
+}
+
+func pollFuseWorker(socket int, budget time.Duration) error {
+	deadline := time.Now().Add(budget)
+	poll := []unix.PollFd{{Fd: int32(socket), Events: unix.POLLIN}}
+	for {
+		left := time.Until(deadline)
+		if left <= 0 {
+			return syscall.ETIMEDOUT
+		}
+		count, err := unix.Poll(poll, int((left+time.Millisecond-1)/time.Millisecond))
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if count == 0 {
+			return syscall.ETIMEDOUT
+		}
+		return nil
+	}
+}
+
+func readFuseMountTarget(socket int) (*fuseMountTarget, uint64, error) {
+	data := make([]byte, unix.PathMax+12)
+	control := make([]byte, unix.CmsgSpace(4))
+	n, cn, flags, _, err := unix.Recvmsg(socket, data, control, unix.MSG_DONTWAIT|unix.MSG_CMSG_CLOEXEC)
+	if err != nil {
+		return nil, 0, syscall.EIO
+	}
+	msgs, err := unix.ParseSocketControlMessage(control[:cn])
+	if err != nil {
+		return nil, 0, syscall.EIO
+	}
+	var fds []int
+	for i := range msgs {
+		rights, err := unix.ParseUnixRights(&msgs[i])
+		if err != nil {
+			for _, fd := range fds {
+				unix.Close(fd)
+			}
+			return nil, 0, syscall.EIO
+		}
+		fds = append(fds, rights...)
+	}
+	defer func() {
+		for _, fd := range fds {
+			unix.Close(fd)
+		}
+	}()
+	if flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 || n < 4 {
+		return nil, 0, syscall.EIO
+	}
+	status := syscall.Errno(binary.NativeEndian.Uint32(data[:4]))
+	if n == 4 && len(fds) == 0 {
+		if status == 0 {
+			return &fuseMountTarget{}, 0, nil
+		}
+		return nil, 0, status
+	}
+	if status != 0 || n <= 12 || len(fds) != 1 {
+		return nil, 0, syscall.EIO
+	}
+	path := string(data[12:n])
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, 0, syscall.EXDEV
+	}
+	target := os.NewFile(uintptr(fds[0]), "pinned FUSE target")
+	fds = nil
+	return &fuseMountTarget{file: target, path: path}, binary.NativeEndian.Uint64(data[4:12]), nil
+}
