+func pinnedTCXProgramsPresent(iface netlink.Link, pinDir, ingress, egress string, checkEgress bool) (bool, error) {
+	loaded, err := endpointTCXHookPresent(iface, pinDir, ingress, netlink.HANDLE_MIN_INGRESS)
+	if err != nil || !loaded || !checkEgress {
+		return loaded, err
+	}
+	return endpointTCXHookPresent(iface, pinDir, egress, netlink.HANDLE_MIN_EGRESS)
+}
+
+// endpointTCXHookPresent checks the link pinned by the loader for this endpoint.
+// A detached TCX link can remain pinned, but the kernel clears its ifindex.
+func endpointTCXHookPresent(iface netlink.Link, dir, program string, parent uint32) (bool, error) {
+	pin := filepath.Join(dir, program)
+	pinned, err := link.LoadPinnedLink(pin, nil)
+	if errors.Is(err, os.ErrNotExist) {
+		// attachSKBProgram can fall back to legacy tc.
+		return hasCiliumTCFilters(iface, parent)
+	}
+	if err != nil {
+		return false, fmt.Errorf("opening endpoint link %s: %w", pin, err)
+	}
+	defer pinned.Close()
+	info, err := pinned.Info()
+	if err != nil {
+		return false, fmt.Errorf("reading endpoint link %s: %w", pin, err)
+	}
+	tcx := info.TCX()
+	return tcx != nil && ebpf.AttachType(tcx.AttachType) == parentToAttachType(parent) &&
+		tcx.Ifindex == uint32(iface.Attrs().Index) && info.Program != 0, nil
+}
